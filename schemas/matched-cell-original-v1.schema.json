{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-cell-original-v1.schema.json",
  "title": "PlanMargin matched-search cell original checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "identity", "configuration_fingerprint", "scenario", "support_model_fingerprint", "original", "cost", "checkpoint_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-cell-original-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.matched_cell_original_checkpoint"},
    "identity": {"$ref": "#/$defs/cellIdentity"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "scenario": {"type": "object", "required": ["scenario_id", "source_shard", "shard_index", "record_index", "selection_order", "mutated_object_index"]},
    "support_model_fingerprint": {"$ref": "#/$defs/sha256"},
    "original": {"type": "object", "required": ["eligible", "controllers"]},
    "cost": {"$ref": "#/$defs/cost"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cellIdentity": {"type": "object", "additionalProperties": false, "required": ["method", "track", "seed", "selection_order", "proposal_index"], "properties": {"method": {"enum": ["random", "bayesian"]}, "track": {"enum": ["natural", "headway_regression"]}, "seed": {"type": "integer", "minimum": 0, "maximum": 4}, "selection_order": {"type": "integer", "minimum": 1, "maximum": 10}, "proposal_index": {"type": "null"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["core_mutation_attempts", "scenario_validation_logical_evaluations", "scenario_validation_physical_rollouts", "tested_controller_logical_evaluations", "tested_controller_physical_rollouts", "reference_controller_logical_evaluations", "reference_controller_physical_rollouts", "total_physical_rollouts", "waymax_rollout_steps"], "properties": {"core_mutation_attempts": {"type": "integer", "minimum": 0}, "scenario_validation_logical_evaluations": {"type": "integer", "minimum": 0}, "scenario_validation_physical_rollouts": {"type": "integer", "minimum": 0}, "tested_controller_logical_evaluations": {"type": "integer", "minimum": 0}, "tested_controller_physical_rollouts": {"type": "integer", "minimum": 0}, "reference_controller_logical_evaluations": {"type": "integer", "minimum": 0}, "reference_controller_physical_rollouts": {"type": "integer", "minimum": 0}, "total_physical_rollouts": {"type": "integer", "minimum": 0}, "waymax_rollout_steps": {"type": "integer", "minimum": 0}}}
  }
}
