{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-report-v1.schema.json",
  "title": "PlanMargin regression eligibility aggregate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "identity", "configuration_fingerprint", "status", "decision", "integrity_gates", "eligibility_gate", "metrics", "cost", "limitations", "report_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-report-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.regression_eligibility_report"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["track", "selection_order"], "properties": {"track": {"const": "headway_regression"}, "selection_order": {"type": "null"}}},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "status": {"const": "completed"},
    "decision": {"enum": ["go", "no_go", "invalid_gate"]},
    "integrity_gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "eligibility_gate": {"type": "object", "required": ["minimum_eligible_scenario_count", "eligible_scenario_count", "passes"]},
    "metrics": {"type": "object", "required": ["scenario_count", "eligible_scenario_count", "ineligible_scenario_count", "deterministic_scenario_count", "recorded_work_seconds", "final_invocation_seconds", "process_peak_rss_bytes"]},
    "cost": {"type": "object", "required": ["total_physical_rollouts", "waymax_rollout_steps"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
