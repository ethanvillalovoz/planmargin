{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-run-manifest-v1.schema.json",
  "title": "PlanMargin regression eligibility run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "identity", "configuration_fingerprint", "configuration", "environment", "manifest_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-run-manifest-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.regression_eligibility_run_manifest"},
    "identity": {"$ref": "#/$defs/gateIdentity"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "configuration": {"type": "object", "required": ["experiment", "identity", "dataset", "controllers", "gate", "accounting", "source"]},
    "environment": {"type": "object", "required": ["python", "platform", "machine", "numpy", "jax", "tensorflow", "jax_backend"]},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gateIdentity": {"type": "object", "additionalProperties": false, "required": ["track", "selection_order"], "properties": {"track": {"const": "headway_regression"}, "selection_order": {"type": "null"}}}
  }
}
