{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/empirical-support-model-v1.schema.json",
  "title": "PlanMargin empirical-support model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "configuration_fingerprint", "event_count", "model", "model_fingerprint", "model_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/empirical-support-model-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.empirical_support_model"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "event_count": {"type": "integer", "minimum": 8},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_names", "numeric_dtype", "split", "scaling", "neighbor_count", "support_alpha", "ties_included", "reference_vectors", "calibration_scores"],
      "properties": {
        "feature_names": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}},
        "numeric_dtype": {"const": "float64"},
        "split": {"type": "object", "required": ["ordering", "reference_fraction", "reference_event_keys", "calibration_event_keys"]},
        "scaling": {"type": "object", "required": ["median", "first_quartile", "third_quartile", "iqr", "effective_iqr", "iqr_floor", "quantile_method"]},
        "neighbor_count": {"const": 5},
        "support_alpha": {"const": 0.05},
        "ties_included": {"const": true},
        "reference_vectors": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/vector"}},
        "calibration_scores": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}
      }
    },
    "model_fingerprint": {"$ref": "#/$defs/sha256"},
    "model_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vector": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "number"}}
  }
}
