{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/rollout-record-collection-v1.schema.json",
  "title": "PlanMargin rollout record collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "collection_status",
    "comparison_key",
    "comparison_finding",
    "records"
  ],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/rollout-record-collection-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.rollout_record_collection"},
    "collection_status": {"enum": ["complete", "invalid_candidate"]},
    "comparison_key": {"type": "string", "pattern": "^cmp_[0-9a-f]{64}$"},
    "comparison_finding": {"type": "object"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rolloutRecord"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"collection_status": {"const": "complete"}}, "required": ["collection_status"]},
      "then": {
        "properties": {
          "records": {
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/rolloutRecord"},
                {"properties": {"status": {"const": "completed"}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"collection_status": {"const": "invalid_candidate"}}, "required": ["collection_status"]},
      "then": {
        "properties": {
          "records": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/rolloutRecord"},
                {"properties": {"status": {"const": "invalid"}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "rolloutRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "comparison_key",
        "record_kind",
        "status",
        "variant",
        "scenario",
        "controller_set",
        "controller_role",
        "controller",
        "mutation",
        "metric_configuration",
        "outcome",
        "acceptance_gate_results",
        "reproducibility",
        "trajectory",
        "provenance",
        "rejection_reasons",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "record_type": {"const": "planmargin.rollout_record"},
        "record_id": {"type": "string", "pattern": "^rec_[0-9a-f]{64}$"},
        "comparison_key": {"type": "string", "pattern": "^cmp_[0-9a-f]{64}$"},
        "record_kind": {"enum": ["rollout", "invalid_candidate"]},
        "status": {"enum": ["completed", "invalid"]},
        "variant": {"enum": ["original", "counterfactual"]},
        "scenario": {
          "type": "object",
          "required": ["name", "version", "split", "scenario_id", "source_shard", "record_index", "mutated_object_index"],
          "additionalProperties": true,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "split": {"type": "string", "minLength": 1},
            "scenario_id": {"type": "string", "minLength": 1},
            "source_shard": {"type": "string", "minLength": 1},
            "record_index": {"type": "integer", "minimum": 0},
            "mutated_object_index": {"type": "integer", "minimum": 0}
          }
        },
        "controller_set": {
          "type": "object",
          "required": ["tested", "reference"],
          "additionalProperties": false,
          "properties": {
            "tested": {"$ref": "#/$defs/controller"},
            "reference": {"$ref": "#/$defs/controller"}
          }
        },
        "controller_role": {"type": ["string", "null"], "enum": ["tested", "reference", null]},
        "controller": {"type": ["object", "null"]},
        "mutation": {
          "type": "object",
          "required": ["schema_version", "mutation_type", "applied", "parameters", "rejection_reasons"],
          "additionalProperties": true,
          "properties": {
            "schema_version": {"type": "integer", "minimum": 1},
            "mutation_type": {"type": "string", "minLength": 1},
            "applied": {"type": "boolean"},
            "parameters": {"type": "object"},
            "rejection_reasons": {"type": "array", "items": {"type": "string"}}
          }
        },
        "metric_configuration": {"type": "object"},
        "outcome": {"type": ["object", "null"]},
        "acceptance_gate_results": {"type": "object"},
        "reproducibility": {"type": ["object", "null"]},
        "trajectory": {"type": ["object", "null"]},
        "provenance": {
          "type": "object",
          "required": ["git_revision", "seed", "runtime", "hardware_class"],
          "additionalProperties": true,
          "properties": {
            "git_revision": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "runtime": {"type": "object"},
            "hardware_class": {
              "type": "object",
              "required": ["platform", "machine", "jax_backend"],
              "properties": {
                "platform": {"type": "string", "minLength": 1},
                "machine": {"type": "string", "minLength": 1},
                "jax_backend": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "rejection_reasons": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "record_kind": {"const": "rollout"},
              "controller_role": {"enum": ["tested", "reference"]},
              "controller": {"$ref": "#/$defs/controller"},
              "outcome": {"type": "object"},
              "reproducibility": {"type": "object"},
              "trajectory": {"type": "object"},
              "rejection_reasons": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "completed"},
              "variant": {"const": "original"}
            },
            "required": ["status", "variant"]
          },
          "then": {
            "properties": {
              "mutation": {
                "properties": {"applied": {"const": false}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "completed"},
              "variant": {"const": "counterfactual"}
            },
            "required": ["status", "variant"]
          },
          "then": {
            "properties": {
              "mutation": {
                "properties": {"applied": {"const": true}}
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "invalid"}}, "required": ["status"]},
          "then": {
            "properties": {
              "record_kind": {"const": "invalid_candidate"},
              "variant": {"const": "counterfactual"},
              "controller_role": {"type": "null"},
              "controller": {"type": "null"},
              "outcome": {"type": "null"},
              "reproducibility": {"type": "null"},
              "trajectory": {"type": "null"},
              "mutation": {
                "properties": {"applied": {"const": false}}
              },
              "rejection_reasons": {"minItems": 1}
            }
          }
        }
      ]
    },
    "controller": {
      "type": "object",
      "required": ["controller_id"],
      "additionalProperties": true,
      "properties": {
        "controller_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
