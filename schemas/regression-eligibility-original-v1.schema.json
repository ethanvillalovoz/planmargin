{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-original-v1.schema.json",
  "title": "PlanMargin regression eligibility original checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "identity", "configuration_fingerprint", "scenario", "original", "eligible", "cost", "checkpoint_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/regression-eligibility-original-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.regression_eligibility_original_checkpoint"},
    "identity": {"$ref": "#/$defs/originalIdentity"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "scenario": {"type": "object", "required": ["scenario_id", "selection_order", "mutated_object_index"]},
    "original": {"type": "object", "required": ["eligible", "controllers"]},
    "eligible": {"type": "boolean"},
    "cost": {"type": "object", "required": ["core_mutation_attempts", "tested_controller_physical_rollouts", "reference_controller_physical_rollouts", "total_physical_rollouts", "waymax_rollout_steps"]},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "originalIdentity": {"type": "object", "additionalProperties": false, "required": ["track", "selection_order"], "properties": {"track": {"const": "headway_regression"}, "selection_order": {"type": "integer", "minimum": 1, "maximum": 10}}}
  }
}
