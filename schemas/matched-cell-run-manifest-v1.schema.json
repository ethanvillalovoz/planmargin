{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-cell-run-manifest-v1.schema.json",
  "title": "PlanMargin matched-search cell run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "identity", "configuration_fingerprint", "configuration", "environment", "manifest_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-cell-run-manifest-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.matched_cell_run_manifest"},
    "identity": {"$ref": "#/$defs/cellIdentity"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment", "cell", "dataset", "search", "support", "mutation", "controllers", "accounting", "source"],
      "properties": {
        "experiment": {"const": "matched_random_bayesian_lead_braking_v2"},
        "cell": {"$ref": "#/$defs/cellIdentity"},
        "dataset": {"type": "object", "required": ["name", "version", "split", "scenario_manifest_sha256", "scenario"]},
        "search": {"type": "object", "required": ["methods", "tracks", "seeds", "proposal_budget", "sobol_initialization_count", "onset_offsets_s", "minimum_speed_multiplier", "maximum_speed_multiplier", "numeric_dtype", "device", "acquisition"]},
        "support": {"type": "object", "additionalProperties": false, "required": ["model_fingerprint", "model_sha256", "feature_schema_version"], "properties": {"model_fingerprint": {"$ref": "#/$defs/sha256"}, "model_sha256": {"$ref": "#/$defs/sha256"}, "feature_schema_version": {"const": "1.0.0"}}},
        "mutation": {"type": "object", "required": ["type", "fixed_configuration"]},
        "controllers": {"type": "object", "additionalProperties": false, "required": ["tested", "reference"], "properties": {"tested": {"type": "object"}, "reference": {"type": "object"}}},
        "accounting": {"type": "object", "required": ["primary_budget_unit", "budget_per_cell", "rejected_and_duplicate_proposals_consume_budget", "exhaust_budget_after_finding", "deterministic_physical_rollouts_per_logical_evaluation", "waymax_steps_per_physical_rollout"]},
        "source": {"type": "object", "required": ["git_commit", "git_worktree_dirty", "matched_coordinator_source_sha256", "matched_search_source_sha256", "waymax_git_commit"]}
      }
    },
    "environment": {"type": "object", "required": ["python", "platform", "machine", "numpy", "jax", "tensorflow", "jax_backend", "matched_search"]},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cellIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "track", "seed", "selection_order", "proposal_index"],
      "properties": {
        "method": {"enum": ["random", "bayesian"]},
        "track": {"enum": ["natural", "headway_regression"]},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4},
        "selection_order": {"type": "integer", "minimum": 1, "maximum": 10},
        "proposal_index": {"type": "null"}
      }
    }
  }
}
