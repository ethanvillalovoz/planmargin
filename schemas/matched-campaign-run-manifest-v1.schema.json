{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-campaign-run-manifest-v1.schema.json",
  "title": "PlanMargin matched-search campaign run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "record_type", "campaign_id", "configuration_fingerprint", "configuration", "environment", "manifest_sha256"],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/matched-campaign-run-manifest-v1.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "planmargin.matched_campaign_run_manifest"},
    "campaign_id": {"const": "natural-development-v1"},
    "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
    "configuration": {"type": "object"},
    "environment": {"type": "object"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
