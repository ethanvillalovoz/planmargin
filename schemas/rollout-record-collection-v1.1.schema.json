{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/rollout-record-collection-v1.1.schema.json",
  "title": "PlanMargin rollout record collection v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "collection_status",
    "comparison_key",
    "comparison_finding",
    "scene_context",
    "records"
  ],
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/rollout-record-collection-v1.1.schema.json"},
    "schema_version": {"const": "1.1.0"},
    "record_type": {"const": "planmargin.rollout_record_collection"},
    "collection_status": {"enum": ["complete", "invalid_candidate"]},
    "comparison_key": {"type": "string", "pattern": "^cmp_[0-9a-f]{64}$"},
    "comparison_finding": {"type": "object"},
    "scene_context": {
      "oneOf": [
        {"$ref": "#/$defs/sceneContext"},
        {"type": "null"}
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rolloutRecord"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"collection_status": {"const": "complete"}}, "required": ["collection_status"]},
      "then": {
        "properties": {
          "scene_context": {"$ref": "#/$defs/sceneContext"},
          "records": {
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/rolloutRecord"},
                {"properties": {"status": {"const": "completed"}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"collection_status": {"const": "invalid_candidate"}}, "required": ["collection_status"]},
      "then": {
        "properties": {
          "records": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "allOf": [
                {"$ref": "#/$defs/rolloutRecord"},
                {"properties": {"status": {"const": "invalid"}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sceneContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_frame", "units", "bounds_m", "roadgraph_features", "actors"],
      "properties": {
        "coordinate_frame": {"type": "string", "minLength": 1},
        "units": {"const": "meters"},
        "bounds_m": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_x_m", "max_x_m", "min_y_m", "max_y_m"],
          "properties": {
            "min_x_m": {"type": "number"},
            "max_x_m": {"type": "number"},
            "min_y_m": {"type": "number"},
            "max_y_m": {"type": "number"}
          }
        },
        "roadgraph_features": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/roadgraphFeature"}
        },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sdc", "mutation_target"],
          "properties": {
            "sdc": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object_type", "length_m", "width_m"],
              "properties": {
                "object_type": {"type": "integer"},
                "length_m": {"type": "number", "exclusiveMinimum": 0},
                "width_m": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            "mutation_target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object_type", "original", "counterfactual"],
              "properties": {
                "object_type": {"type": "integer"},
                "original": {"$ref": "#/$defs/actorTrack"},
                "counterfactual": {"$ref": "#/$defs/actorTrack"}
              }
            }
          }
        }
      }
    },
    "roadgraphFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_type", "x_m", "y_m"],
      "properties": {
        "feature_type": {"type": "integer"},
        "x_m": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "y_m": {"type": "array", "minItems": 2, "items": {"type": "number"}}
      }
    },
    "actorTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestep", "x_m", "y_m", "yaw_rad", "length_m", "width_m", "valid"],
      "properties": {
        "timestep": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "x_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "y_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "yaw_rad": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "length_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "width_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "valid": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}
      }
    },
    "rolloutRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "record_id",
        "comparison_key",
        "record_kind",
        "status",
        "variant",
        "scenario",
        "controller_set",
        "controller_role",
        "controller",
        "mutation",
        "metric_configuration",
        "outcome",
        "acceptance_gate_results",
        "reproducibility",
        "trajectory",
        "provenance",
        "rejection_reasons",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "1.1.0"},
        "record_type": {"const": "planmargin.rollout_record"},
        "record_id": {"type": "string", "pattern": "^rec_[0-9a-f]{64}$"},
        "comparison_key": {"type": "string", "pattern": "^cmp_[0-9a-f]{64}$"},
        "record_kind": {"enum": ["rollout", "invalid_candidate"]},
        "status": {"enum": ["completed", "invalid"]},
        "variant": {"enum": ["original", "counterfactual"]},
        "scenario": {
          "type": "object",
          "required": ["name", "version", "split", "scenario_id", "source_shard", "record_index", "mutated_object_index"],
          "additionalProperties": true,
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "split": {"type": "string", "minLength": 1},
            "scenario_id": {"type": "string", "minLength": 1},
            "source_shard": {"type": "string", "minLength": 1},
            "record_index": {"type": "integer", "minimum": 0},
            "mutated_object_index": {"type": "integer", "minimum": 0}
          }
        },
        "controller_set": {
          "type": "object",
          "required": ["tested", "reference"],
          "additionalProperties": false,
          "properties": {
            "tested": {"$ref": "#/$defs/controller"},
            "reference": {"$ref": "#/$defs/controller"}
          }
        },
        "controller_role": {"type": ["string", "null"], "enum": ["tested", "reference", null]},
        "controller": {"type": ["object", "null"]},
        "mutation": {
          "type": "object",
          "required": ["schema_version", "mutation_type", "applied", "parameters", "rejection_reasons"],
          "additionalProperties": true,
          "properties": {
            "schema_version": {"type": "integer", "minimum": 1},
            "mutation_type": {"type": "string", "minLength": 1},
            "applied": {"type": "boolean"},
            "parameters": {"type": "object"},
            "rejection_reasons": {"type": "array", "items": {"type": "string"}}
          }
        },
        "metric_configuration": {"type": "object"},
        "outcome": {"oneOf": [{"$ref": "#/$defs/outcome"}, {"type": "null"}]},
        "acceptance_gate_results": {"type": "object"},
        "reproducibility": {"type": ["object", "null"]},
        "trajectory": {"oneOf": [{"$ref": "#/$defs/trajectory"}, {"type": "null"}]},
        "provenance": {
          "type": "object",
          "required": ["git_revision", "seed", "runtime", "hardware_class"],
          "additionalProperties": true,
          "properties": {
            "git_revision": {"type": "string", "minLength": 1},
            "seed": {"type": "integer"},
            "runtime": {"type": "object"},
            "hardware_class": {
              "type": "object",
              "required": ["platform", "machine", "jax_backend"],
              "properties": {
                "platform": {"type": "string", "minLength": 1},
                "machine": {"type": "string", "minLength": 1},
                "jax_backend": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "rejection_reasons": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "record_kind": {"const": "rollout"},
              "controller_role": {"enum": ["tested", "reference"]},
              "controller": {"$ref": "#/$defs/controller"},
              "outcome": {"$ref": "#/$defs/outcome"},
              "reproducibility": {"type": "object"},
              "trajectory": {"$ref": "#/$defs/trajectory"},
              "rejection_reasons": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "completed"}, "variant": {"const": "original"}}, "required": ["status", "variant"]},
          "then": {"properties": {"mutation": {"properties": {"applied": {"const": false}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "completed"}, "variant": {"const": "counterfactual"}}, "required": ["status", "variant"]},
          "then": {"properties": {"mutation": {"properties": {"applied": {"const": true}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "invalid"}}, "required": ["status"]},
          "then": {
            "properties": {
              "record_kind": {"const": "invalid_candidate"},
              "variant": {"const": "counterfactual"},
              "controller_role": {"type": "null"},
              "controller": {"type": "null"},
              "outcome": {"type": "null"},
              "reproducibility": {"type": "null"},
              "trajectory": {"type": "null"},
              "mutation": {"properties": {"applied": {"const": false}}},
              "rejection_reasons": {"minItems": 1}
            }
          }
        }
      ]
    },
    "controller": {
      "type": "object",
      "required": ["controller_id"],
      "additionalProperties": true,
      "properties": {"controller_id": {"type": "string", "minLength": 1}}
    },
    "outcome": {
      "type": "object",
      "additionalProperties": true,
      "required": ["success", "failure_reasons", "max_sdc_overlap", "max_sdc_offroad", "final_timestep", "expected_final_timestep", "first_failure_timestep", "first_failure_reasons"],
      "properties": {
        "success": {"type": "boolean"},
        "failure_reasons": {"type": "array", "items": {"type": "string"}},
        "max_sdc_overlap": {"type": "number"},
        "max_sdc_offroad": {"type": "number"},
        "final_timestep": {"type": "integer"},
        "expected_final_timestep": {"type": "integer"},
        "first_failure_timestep": {"type": ["integer", "null"]},
        "first_failure_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timestep", "x_m", "y_m", "yaw_rad", "speed_mps", "valid"],
      "properties": {
        "timestep": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "x_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "y_m": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "yaw_rad": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "speed_mps": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "valid": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}
      }
    }
  }
}
