{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/fault-protection-public-v1.schema.json",
  "title": "PlanMargin public fault-protection result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "record_type",
    "status",
    "protocol",
    "dataset",
    "summary",
    "gates",
    "source_report_sha256",
    "claim_boundary",
    "redistribution",
    "report_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/ethanvillalovoz/planmargin/main/schemas/fault-protection-public-v1.schema.json"
    },
    "schema_version": { "const": "1.0.0" },
    "record_type": { "const": "planmargin.public_fault_protection_result" },
    "status": { "enum": ["qualified", "no_go"] },
    "protocol": {
      "type": "object",
      "required": [
        "fault",
        "fault_onset_step",
        "fault_onset_seconds",
        "unprotected_behavior",
        "protected_behavior",
        "primary_controller",
        "fallback_controller",
        "physical_rollouts",
        "waymax_steps"
      ],
      "properties": {
        "fault": { "const": "sustained_primary_command_dropout" },
        "fault_onset_step": { "type": "integer", "minimum": 0 },
        "fault_onset_seconds": { "type": "number", "minimum": 0 },
        "unprotected_behavior": { "type": "string", "minLength": 1 },
        "protected_behavior": { "type": "string", "minLength": 1 },
        "primary_controller": { "type": "object" },
        "fallback_controller": { "type": "object" },
        "physical_rollouts": { "type": "integer", "minimum": 1 },
        "waymax_steps": { "type": "integer", "minimum": 1 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "split", "synthetic", "scenario_count"],
      "properties": {
        "name": { "const": "Waymo Open Motion Dataset" },
        "version": { "type": "string", "minLength": 1 },
        "split": { "const": "training" },
        "synthetic": { "const": false },
        "scenario_count": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_success_count",
        "unprotected_fault_manifestation_count",
        "protected_fallback_success_count",
        "scene_gate_passes",
        "scene_gate_total"
      ],
      "properties": {
        "baseline_success_count": { "type": "integer", "minimum": 0 },
        "unprotected_fault_manifestation_count": {
          "type": "integer",
          "minimum": 0
        },
        "protected_fallback_success_count": { "type": "integer", "minimum": 0 },
        "scene_gate_passes": { "type": "integer", "minimum": 0 },
        "scene_gate_total": { "type": "integer", "minimum": 1 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "type": "boolean" },
      "required": [
        "all_baselines_pass",
        "all_unprotected_faults_manifested",
        "all_protected_fallbacks_pass",
        "all_scene_gates_pass",
        "real_womd_only",
        "exactly_ten_scenes"
      ]
    },
    "source_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim_boundary": { "type": "string", "minLength": 1 },
    "redistribution": { "const": "aggregate_only" },
    "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
